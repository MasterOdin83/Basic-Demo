    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "jest-editor-support": "*"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "jsdom": "^27.1.0",
    "typescript": "~6.0.3",
